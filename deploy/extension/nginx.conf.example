# Include at nginx http{} scope; replace domain and existing TLS certificate paths.
map $http_upgrade $foxprofile_extension_connection {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name foxprofile.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name foxprofile.example.com;
    ssl_certificate /etc/ssl/foxprofile-extension/fullchain.pem;
    ssl_certificate_key /etc/ssl/foxprofile-extension/privkey.pem;
    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $foxprofile_extension_connection;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_buffering off;
    }
}
