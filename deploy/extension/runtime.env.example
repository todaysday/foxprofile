# Set before importing src.core.config; install private copy as runtime.env.
FOXPROFILE_EXT_ENABLED=true
FOXPROFILE_EXT_DB=/srv/foxprofile-extension/state.sqlite3
FOXPROFILE_DATA_DIR=/srv/foxprofile-extension/profiles
FOXPROFILE_PROFILES_FILE=/srv/foxprofile-extension/catalog.json
FOXPROFILE_LOG_DIR=/srv/foxprofile-extension/logs
FOXPROFILE_HEADLESS=virtual
FOXPROFILE_API_HOST=127.0.0.1
FOXPROFILE_API_PORT=8000
# Install and verify browser builds before startup. No implicit browser download.
FOXPROFILE_CAMOUFOX_EXECUTABLE=/opt/foxprofile-extension/browsers/camoufox/camoufox-bin
FOXPROFILE_CHROME_EXECUTABLE=/opt/foxprofile-extension/browsers/chrome/chrome
FOXPROFILE_X11VNC_EXECUTABLE=/usr/bin/x11vnc
# Deliberately invalid until replaced with the actual independently verified hash.
FOXPROFILE_X11VNC_SHA256=REPLACE_WITH_OPERATOR_VERIFIED_64_HEX_SHA256
# Machine-only archive access remains disabled unless explicitly scoped.
FOXPROFILE_EXT_SERVICE_TRANSFER_ROOTS=
