# Non-secret Worker configuration. Install as /etc/foxprofile-worker/worker.env.
FOXPROFILE_WORKER_ID=replace-with-master-enrolled-worker-id
FOXPROFILE_WORKER_MASTER_URL=wss://master.example.invalid
FOXPROFILE_WORKER_STATE_DIR=/var/lib/foxprofile-worker
FOXPROFILE_WORKER_MANIFEST=/etc/foxprofile-worker/runtime-manifest.json
FOXPROFILE_WORKER_NATIVE_EVIDENCE=/etc/foxprofile-worker/native-evidence.json
FOXPROFILE_WORKER_EXPECTED_MANIFEST_SHA256=replace-with-preflight-digest
FOXPROFILE_WORKER_LOSS_TIMEOUT=30
FOXPROFILE_WORKER_TERM_GRACE=2
FOXPROFILE_WORKER_KILL_GRACE=2
FOXPROFILE_WORKER_SYSTEM_RESERVE_BYTES=536870912
FOXPROFILE_WORKER_STAGING_RESERVE_BYTES=2147483648
# Optional: configure only after independently pinning the installed binary.
# FOXPROFILE_X11VNC_EXECUTABLE=/usr/bin/x11vnc
# FOXPROFILE_X11VNC_SHA256=replace-with-verified-binary-sha256
