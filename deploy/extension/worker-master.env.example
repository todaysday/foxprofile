# Add to the resolved protected Master runtime configuration.
# Keep the existing one-manager/one-ASGI-worker installation and private paths.
# Resolve the public origin and use the independently verified shared manifest
# digest produced by tools/worker_preflight.py; placeholders must not be deployed.
FOXPROFILE_WORKERS_ENABLED=true
FOXPROFILE_MASTER_URL=https://master.example.test
FOXPROFILE_RUNTIME_MANIFEST_SHA256=REPLACE_WITH_VERIFIED_MANIFEST_SHA256
FOXPROFILE_RUNTIME_MANIFEST=/etc/foxprofile/runtime-manifest.json
FOXPROFILE_NATIVE_EVIDENCE=/etc/foxprofile/master-native-evidence.json

# Master local admission uses the same verified manifest as the Workers.
# Its existing FOXPROFILE_CAMOUFOX_EXECUTABLE / FOXPROFILE_CHROME_EXECUTABLE
# settings must resolve to the corresponding manifest's pinned binary paths.

# Bytes. Defaults are starting configuration, not measured production capacity.
# Measure 1/5/10 browser RSS and safe reserves on each intended Ubuntu 24.04 host.
FOXPROFILE_BROWSER_MEMORY_BYTES=1073741824
FOXPROFILE_SYSTEM_RESERVE_BYTES=536870912
FOXPROFILE_STAGING_RESERVE_BYTES=2147483648

# Worker credentials are issued by an authenticated personal administrator and
# belong only in each Worker's private credential file. Do not put them here.
